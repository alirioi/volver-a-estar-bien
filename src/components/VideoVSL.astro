---
import { Image } from 'astro:assets';
import posterImg from '../assets/images/minitura vsl1.webp';

const PLAYER_ID = "panda-918952d5-fcb0-4b6a-af00-c836ba1eadf7";
const IFRAME_SRC = "https://player-vz-85291b1d-8d8.tv.pandavideo.com/embed/?v=918952d5-fcb0-4b6a-af00-c836ba1eadf7&autoplay=1";
---

<div class="video-vsl-container" id="videoVslContainer">
  <div class="vsl-wrapper" id="vslWrapper">
    <!-- POSTER: imagen responsive — sirve 400w en móvil, 880w en desktop -->
    <div class="vsl-poster" id="vslPoster">
      <Image
        src={posterImg}
        alt="Workshop Volver a Estar Bien — Video VSL"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="vsl-poster-img"
        widths={[400, 880]}
        sizes="(max-width: 600px) 400px, 880px"
        width={880}
      />
      <div class="vsl-loading-ring" id="vslSpinner" aria-hidden="true"></div>
    </div>

    <!-- IFRAME: Inyectado vía JS para autoplay diferido -->
    <div class="vsl-frame" id="vslFrame">
      <iframe
        id={PLAYER_ID}
        title="Video VSL Workshop Volver a Estar Bien con Yaner Rodríguez"
        style="border:none;"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
        width="100%"
        height="100%"
      ></iframe>
    </div>
  </div>
</div>

<script define:vars={{ PLAYER_ID, IFRAME_SRC }}>
  (function () {
    const poster = document.getElementById('vslPoster');
    const frame  = document.getElementById('vslFrame');
    const iframe = document.getElementById(PLAYER_ID);
    const container = document.getElementById('videoVslContainer');
    let injected = false;

    function injectVideo() {
      if (injected || !iframe || iframe.src) return;
      injected = true;
      iframe.src = IFRAME_SRC;

      iframe.addEventListener('load', () => {
        if (poster) poster.classList.add('vsl-poster--hidden');
        if (frame)  frame.removeAttribute('aria-hidden');
        setTimeout(() => {
          if (poster && poster.parentNode) poster.remove();
        }, 500);

        // SDK de PiP SOLO en escritorio (> 768px) y SOLO cuando el iframe carga
        if (window.innerWidth > 768) {
          initPiP();
        }
      }, { once: true });
    }

    function initPiP() {
      if (!document.querySelector('script[src="https://player.pandavideo.com.br/api.v2.js"]')) {
        const s = document.createElement('script');
        s.src = 'https://player.pandavideo.com.br/api.v2.js';
        s.async = true;
        s.onload = attachPiP;
        document.head.appendChild(s);
      } else {
        attachPiP();
      }
    }

    function attachPiP() {
      window.pandascripttag = window.pandascripttag || [];
      window.pandascripttag.push(function () {
        if (typeof PandaPlayer !== 'undefined') {
          const p = new PandaPlayer(PLAYER_ID, {
            onReady() {
              p.pipScrollFollow({ panda_id_player: PLAYER_ID });
            }
          });
        }
      });
    }

    // Inyectar video cuando el contenedor entra en el viewport (mejor que idle en móvil)
    if ('IntersectionObserver' in window && container) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          injectVideo();
          obs.disconnect();
        }
      }, { rootMargin: '200px' }); // precarga 200px antes de que sea visible
      io.observe(container);
    } else {
      // Fallback para browsers sin IntersectionObserver
      setTimeout(injectVideo, 800);
    }
  })();
</script>

<style>
  .video-vsl-container {
    position: relative;
    max-width: 880px;
    margin: 0 auto 30px;
    border-radius: 0 0 16px 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px -15px rgba(62, 29, 117, 0.4);
    background: #1f1b37;
  }

  .vsl-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Fallback 16:9 compatible con iOS Safari */
    height: 0;
    overflow: hidden;
  }

  .vsl-poster {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #1f1b37;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .vsl-poster--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .vsl-poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vsl-loading-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: vsl-spin 0.8s linear infinite;
  }

  @keyframes vsl-spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .vsl-frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }
</style>
