---
import { Image } from 'astro:assets';
import posterImg from '../assets/images/minitura vsl1.webp';

const VIDEO_ID = "1209922173";
const PLAYER_ID = `vimeo-player-${VIDEO_ID}`;
const IFRAME_SRC = `https://player.vimeo.com/video/${VIDEO_ID}?autoplay=1&autopause=0&muted=0&responsive=1&dnt=1`;
---

<div class="video-vsl-container" id="videoVslContainer">
  <div class="vsl-wrapper" id="vslWrapper">
    <!-- POSTER: imagen responsive — sirve 400w en móvil, 880w en desktop -->
    <div class="vsl-poster" id="vslPoster">
      <Image
        src={posterImg}
        alt="Workshop Volver a Estar Bien — Video VSL"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="vsl-poster-img"
        widths={[400, 880]}
        sizes="(max-width: 600px) 400px, 880px"
        width={880}
      />
      <div class="vsl-loading-ring" id="vslSpinner" aria-hidden="true"></div>
    </div>

    <!-- IFRAME: Inyectado vía JS para autoplay diferido y Vimeo Embed -->
    <div class="vsl-frame" id="vslFrame">
      <iframe
        id={PLAYER_ID}
        title="Video VSL Workshop Volver a Estar Bien con Yaner Rodríguez"
        style="border:none;"
        allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
        width="100%"
        height="100%"
      ></iframe>
    </div>
  </div>
</div>

<script define:vars={{ PLAYER_ID, IFRAME_SRC }}>
  (function () {
    const poster = document.getElementById('vslPoster');
    const frame  = document.getElementById('vslFrame');
    const iframe = document.getElementById(PLAYER_ID);
    const container = document.getElementById('videoVslContainer');
    let injected = false;
    let isFloating = false;

    function injectVideo() {
      if (injected || !iframe || iframe.src) return;
      injected = true;
      iframe.src = IFRAME_SRC;

      iframe.addEventListener('load', () => {
        if (poster) poster.classList.add('vsl-poster--hidden');
        if (frame)  frame.removeAttribute('aria-hidden');
        setTimeout(() => {
          if (poster && poster.parentNode) poster.remove();
        }, 500);

        // Activar comportamiento Sticky / PiP al hacer scroll en desktop
        if (window.innerWidth > 768) {
          initScrollPiP();
        }
      }, { once: true });
    }

    function initScrollPiP() {
      if (!('IntersectionObserver' in window) || !container) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          // Si el contenedor original sale de la pantalla hacia arriba
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            if (!isFloating) {
              container.classList.add('vsl-floating-pip');
              isFloating = true;
            }
          } else if (entry.isIntersecting) {
            if (isFloating) {
              container.classList.remove('vsl-floating-pip');
              isFloating = false;
            }
          }
        });
      }, {
        threshold: 0.1
      });

      observer.observe(container);
    }

    // Inyectar video cuando el contenedor entra en el viewport
    if ('IntersectionObserver' in window && container) {
      const io = new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          injectVideo();
          obs.disconnect();
        }
      }, { rootMargin: '200px' });
      io.observe(container);
    } else {
      setTimeout(injectVideo, 800);
    }
  })();
</script>

<style>
  .video-vsl-container {
    position: relative;
    max-width: 880px;
    margin: 0 auto 30px;
    border-radius: 0 0 16px 16px;
    overflow: hidden;
    box-shadow: 0 20px 50px -15px rgba(62, 29, 117, 0.4);
    background: #1f1b37;
    transition: all 0.3s ease;
  }

  .vsl-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Fallback 16:9 compatible con iOS Safari */
    height: 0;
    overflow: hidden;
  }

  .vsl-poster {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #1f1b37;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .vsl-poster--hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .vsl-poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vsl-loading-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border: 4px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    animation: vsl-spin 0.8s linear infinite;
  }

  @keyframes vsl-spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .vsl-frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
  }

  /* PiP Flotante inteligente al hacer scroll en desktop (reemplaza SDK de Panda) */
  :global(.video-vsl-container.vsl-floating-pip) {
    position: fixed !important;
    bottom: 24px !important;
    right: 24px !important;
    width: 320px !important;
    max-width: 90vw !important;
    margin: 0 !important;
    z-index: 9999 !important;
    border-radius: 12px !important;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.15) !important;
    animation: vslSlideIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes vslSlideIn {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>
