<div class="sticky-cta" id="stickyCta" role="region" aria-label="Oferta rápida flotante" aria-hidden="true">
    <div class="p">
        <span class="o" aria-label="Precio original $127 USD">$127 USD</span>
        <span class="n" aria-label="Precio de oferta $17 USD">$17 USD</span>
    </div>
    <a class="cta-btn" href="https://pay.hotmart.com/E98297746K?checkoutMode=10" target="_blank" rel="noopener noreferrer" aria-label="Quiero estar bien - Inscribirse por $17 USD">
        Quiero estar bien <span class="arrow" aria-hidden="true">→</span>
    </a>
</div>

<script>
    const sticky = document.getElementById('stickyCta');
    const hero = document.querySelector('.hero');
    if (sticky && hero) {
        window.addEventListener('scroll', () => {
            const past = window.scrollY > (hero as HTMLElement).offsetHeight - 100;
            sticky.classList.toggle('show', past);
            sticky.setAttribute('aria-hidden', String(!past));
        }, { passive: true });
    }
</script>
