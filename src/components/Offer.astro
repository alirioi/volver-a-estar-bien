---
import { Image } from 'astro:assets';
import mockup from '../assets/images/mockup.webp';
import bonus1 from '../assets/images/bonus1.webp';
import bonus2 from '../assets/images/bonus2.webp';
import bonus3 from '../assets/images/bonus3.webp';
import bonus4 from '../assets/images/bonus4.webp';
---

<section class="offer">
    <div class="wrap">
        <div class="offer-box reveal">
            <div class="offer-head">
                <h2>Todo lo que recibes hoy</h2>
                <Image class="offer-mockup" src={mockup} alt="Material del taller Volver a Estar Bien" width={520} format="webp" loading="lazy" />
            </div>

            <ul class="offer-list">
                <li>
                    <span class="ico">
                        <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-0.125em; margin-right:4px;">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </span>
                    <div>
                        <strong>Taller completo "Volver a Estar Bien"</strong>
                        <span class="d">El Método del Traductor Emocional en 5 pasos.</span>
                    </div>
                </li>
                <li>
                    <Image class="thumb" src={bonus1} alt="BONUS #1 — Reto 72 Horas" width={104} format="webp" loading="lazy" />
                    <div>
                        <strong>BONUS #1 — Reto 72 Horas</strong>
                        <span class="d">Tu primera conversación real, con estructura y cierre positivo, en 3 días.</span>
                    </div>
                </li>
                <li>
                    <Image class="thumb" src={bonus2} alt="BONUS #2 — Guía Conversación S.I.N." width={104} format="webp" loading="lazy" />
                    <div>
                        <strong>BONUS #2 — Guía Conversación S.I.N.</strong>
                        <span class="d">Habla temas incómodos sin que me terminen en pelea o silencio.</span>
                    </div>
                </li>
                <li>
                    <Image class="thumb" src={bonus3} alt="BONUS #3 — Plan Anti-Recaídas" width={104} format="webp" loading="lazy" />
                    <div>
                        <strong>BONUS #3 — Plan Anti-Recaídas</strong>
                        <span class="d">Señales de alerta y qué hacer cuando reaparezca la tensión.</span>
                    </div>
                </li>
                <li>
                    <Image class="thumb" src={bonus4} alt="BONUS #4 — Comunidad de Apoyo" width={104} format="webp" loading="lazy" />
                    <div>
                        <strong>BONUS #4 — Comunidad de Apoyo</strong>
                        <span class="d">No estás sola en esto.</span>
                    </div>
                </li>
            </ul>

            <div class="offer-cta">
                <div class="value-total">
                    <span class="vt-label">Valor total del taller + 5 bonus</span>
                    <span class="vt-num">$127 USD</span>
                </div>
                <div class="price-row">
                    <span class="price-label">Tu inversión hoy</span>
                    <span class="price-now">$17 USD</span>
                </div>
                <p class="trial-close">Menos de lo que cuesta una cena que termina en discusión.</p>
                <div class="cue" aria-hidden="true">↓</div>
                <a class="cta-btn" href="https://pay.hotmart.com/E98297746K?checkoutMode=10" target="_blank" rel="noopener noreferrer">
                    Quiero volver a estar bien <span class="arrow">→</span>
                </a>

                <div class="trust-row">
                    <span>
                        <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-0.125em; margin-right:4px;">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg> Garantía de 7 días
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-0.125em; margin-right:4px;">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                        </svg> Acceso inmediato
                    </span>
                    <span>
                        <svg viewBox="0 0 24 24" width="1.1em" height="1.1em" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-0.125em; margin-right:4px;">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg> Pago seguro con Hotmart
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>
