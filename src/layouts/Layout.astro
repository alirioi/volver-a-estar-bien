---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Volver a Estar Bien — Taller de Comunicación en Pareja | Yaner Rodríguez",
  description = "El Método del Traductor Emocional: el paso a paso de comunicación efectiva que una sola persona puede aplicar para transformar las peleas en acuerdos."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- CSS crítico inline — evita render-blocking para FCP/LCP -->
  <style>
    :root{--rosa:#FFEAFE;--lavanda:#D2C8FF;--peri:#9FA9F0;--morado:#3E1D75;--lila-bg:#F5EFFF;--tinta:#1F1B37;--display:"Fraunces",Georgia,serif;--body:"Figtree",-apple-system,sans-serif;--radius:22px;--maxw:1080px}
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{font-family:var(--body);color:var(--tinta);background:var(--lila-bg);line-height:1.65;font-size:17px;-webkit-font-smoothing:antialiased}
    img{max-width:100%}
    a{color:inherit}
    .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
    h1,h2,h3{font-family:var(--display);font-weight:600;line-height:1.12;letter-spacing:-.01em}
    h1{font-size:clamp(2rem,5.2vw,3.4rem)}
    h2{font-size:clamp(1.6rem,3.6vw,2.4rem)}
    .eyebrow-top{display:block;width:100%;background:#b91c1c;color:#fff;text-align:center;padding:12px 16px;font-size:clamp(.75rem,1.6vw,.88rem);font-weight:700;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 4px 12px rgba(185,28,28,.25)}
    .hero{background:radial-gradient(1100px 600px at 85% -10%,var(--rosa) 0%,transparent 60%),radial-gradient(900px 520px at -10% 30%,var(--lavanda) 0%,transparent 55%),var(--lila-bg);padding:0 0 50px}
    .hero .wrap{max-width:880px;text-align:center}
    .hero h1{margin:70px 0 20px;color:var(--tinta)}
    .hero h1 .accent{color:var(--morado)}
    .hero .hero-sub{margin-bottom:80px}
    .video-notice-banner{background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;text-align:center;padding:12px 20px;font-weight:800;font-size:1rem;letter-spacing:.06em;text-transform:uppercase;border-radius:12px 12px 0 0;margin:40px auto 0;max-width:880px;display:flex;align-items:center;justify-content:center;gap:8px}
    .reveal{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease}
    .reveal.in,.reveal.active{opacity:1;transform:none}
    @media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}
  </style>

  <!-- Preconnect & Asynchronous Non-blocking Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..800,50&family=Figtree:wght@400;500;600;700&display=swap"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..800,50&family=Figtree:wght@400;500;600;700&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,400..800,50&family=Figtree:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </noscript>

  <!-- DNS prefetch & preconnect para PandaVideo — 4 orígenes críticos (320ms savings c/u) -->
  <link rel="dns-prefetch" href="https://player-vz-85291b1d-8d8.tv.pandavideo.com" />
  <link rel="dns-prefetch" href="https://b-vz-85291b1d-8d8.tv.pandavideo.com.br" />
  <link rel="dns-prefetch" href="https://config.tv.pandavideo.com.br" />
  <link rel="dns-prefetch" href="https://thumbs.tv.pandavideo.com.br" />
  <link rel="dns-prefetch" href="https://cdn.pandavideo.com" />
  <!-- preconnect sin crossorigin para solicitudes de navegación del iframe -->
  <link rel="preconnect" href="https://player-vz-85291b1d-8d8.tv.pandavideo.com" />
  <link rel="preconnect" href="https://b-vz-85291b1d-8d8.tv.pandavideo.com.br" />
  <link rel="preconnect" href="https://config.tv.pandavideo.com.br" />
  <link rel="preconnect" href="https://thumbs.tv.pandavideo.com.br" />
</head>
<body>
  <slot />
</body>
</html>
